                android:type="linear">
                <item android:offset="0.0" android:color="#FF9055FF" />
                <item android:offset="1.0" android:color="#FF00D2FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bullseye Center Dot -->
    <path
        android:pathData="M75,54m-3.5,0a3.5,3.5 0 1,1 7,0a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#FF00D2FF" />
