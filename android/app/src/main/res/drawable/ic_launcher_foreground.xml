                android:startY="21"
                android:endX="87"
                android:endY="87"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF673AB7" />
                <item android:offset="0.5" android:color="#FF9055FF" />
                <item android:offset="1.0" android:color="#FF00D2FF" />
            </gradient>
