#!/bin/sh

ENABLED=yes
DESC="TGStrm Microservice"
APP_DIR=/opt/app/tg-streamer
PID_FILE=/opt/var/run/tg-streamer.pid
SUP_PID_FILE=/opt/var/run/tg-streamer-sup.pid
LOG_FILE=/tmp/tg-streamer.log
MAX_LOG_BYTES=5242880 # 5 MB cap

rotate_log() {
    if [ -f "$LOG_FILE" ]; then
        LOG_SIZE=$(wc -c < "$LOG_FILE" 2>/dev/null || echo 0)
        if [ "$LOG_SIZE" -gt "$MAX_LOG_BYTES" ]; then
            tail -n 2000 "$LOG_FILE" > "${LOG_FILE}.old" 2>/dev/null
            cat /dev/null > "$LOG_FILE"
        fi
    fi
}

check_and_heal_node() {
    if ! /opt/bin/node -v >/dev/null 2>&1; then
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] [SUPERVISOR ERROR] /opt/bin/node is corrupted or non-functional!" >> "$LOG_FILE"
        if [ -f "/jffs/bin/node.clean" ] && /jffs/bin/node.clean -v >/dev/null 2>&1; then
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] [SUPERVISOR HEAL] Auto-restoring clean Node binary from /jffs/bin/node.clean..." >> "$LOG_FILE"
            cp /jffs/bin/node.clean /opt/bin/node && chmod 755 /opt/bin/node
        fi
    fi
}

# --- node_modules self-heal (second-disk copy) ---
# Clean node_modules copy + md5 manifest live on the second disk (not the Entware disk that can be damaged).
# Build them on the PC with scripts/build-deps-backup.mjs and copy them to this folder.
DEPS_BACKUP_DIR=/tmp/mnt/ASUS-USB/tg-streamer-deps

sup_log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"
}

# Write the node_modules files that are missing or differ from the manifest into $1; success when none
verify_deps() {
    ( cd "$APP_DIR" && md5sum -c "$DEPS_BACKUP_DIR/node_modules.md5" 2>/dev/null ) | grep ': FAILED' | sed 's/: FAILED.*$//' > "$1"
    [ ! -s "$1" ]
}

# Restore corrupted/missing node_modules files from the second-disk copy (e.g. after e2fsck removed files).
# Returns 1 when node_modules is broken and could not be restored, so the caller backs off instead of crash-looping.
check_and_heal_deps() {
    # The second disk can mount a few seconds after the app disk: wait briefly, only right after boot
    WAITED=0
    while [ ! -f "$DEPS_BACKUP_DIR/node_modules.md5" ] && [ "$WAITED" -lt 60 ] && [ "$(cut -d. -f1 /proc/uptime)" -lt 600 ]; do
        sleep 5
        WAITED=$((WAITED + 5))
    done
    if [ ! -f "$DEPS_BACKUP_DIR/node_modules.md5" ] || [ ! -f "$DEPS_BACKUP_DIR/node_modules.tgz" ] || [ ! -f "$DEPS_BACKUP_DIR/package-lock.md5" ]; then
        sup_log "[SUPERVISOR WARN] dependency backup not found in $DEPS_BACKUP_DIR, skipping node_modules check"
        return 0
    fi
    LOCK_NOW=$(tr -d '\r' < "$APP_DIR/package-lock.json" 2>/dev/null | md5sum | cut -d' ' -f1)
    if [ "$LOCK_NOW" != "$(cut -d' ' -f1 "$DEPS_BACKUP_DIR/package-lock.md5")" ]; then
        sup_log "[SUPERVISOR WARN] dependency backup is stale (package-lock.json changed), skipping node_modules check"
        return 0
    fi

    BAD_LIST=/tmp/tg-streamer-baddeps.txt
    if verify_deps "$BAD_LIST"; then
        return 0
    fi
    sup_log "[SUPERVISOR HEAL] $(wc -l < "$BAD_LIST") corrupted/missing file(s) in node_modules, e.g. $(head -3 "$BAD_LIST" | tr '\n' ' ')- restoring from $DEPS_BACKUP_DIR"
    if tar -xzf "$DEPS_BACKUP_DIR/node_modules.tgz" -C "$APP_DIR" -T "$BAD_LIST" >> "$LOG_FILE" 2>&1 && verify_deps "$BAD_LIST"; then
        sup_log "[SUPERVISOR HEAL] node_modules restored and verified"
        return 0
    fi
    sup_log "[SUPERVISOR ERROR] corrupted dependency: could not restore node_modules ($(wc -l < "$BAD_LIST") file(s) still bad, e.g. $(head -1 "$BAD_LIST")). Retrying in 300s"
    return 1
}
# --- end node_modules self-heal ---

supervisor_loop() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [SUPERVISOR] Starting supervisor loop (PID $$)..." >> "$LOG_FILE"
    CRASH_COUNT=0
    while [ -f "$SUP_PID_FILE" ]; do
        rotate_log

        # Auto-heal: verify /opt/bin/node works before attempting spawn
        check_and_heal_node

        # Auto-heal: restore corrupted/missing node_modules files from the second-disk copy
        if ! check_and_heal_deps; then
            sleep 300
            continue
        fi

        # Verify node binary and index.js exist before attempting spawn
        if [ ! -x "/opt/bin/node" ] || [ ! -f "$APP_DIR/index.js" ]; then
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] [SUPERVISOR ERROR] /opt/bin/node or $APP_DIR/index.js missing. Backing off 30s..." >> "$LOG_FILE"
            sleep 30
            continue
        fi

        echo "[$(date '+%Y-%m-%d %H:%M:%S')] [SUPERVISOR] Spawning node with 256MB heap limit, libfixmadvise and --expose-gc..." >> "$LOG_FILE"
        START_TIME=$(date +%s)
        env LD_PRELOAD=/opt/lib/libfixmadvise.so MALLOC_ARENA_MAX=1 /opt/bin/node --expose-gc --max-old-space-size=256 index.js >> "$LOG_FILE" 2>&1 &
        NODE_PID=$!
        echo $NODE_PID > "$PID_FILE"
        wait $NODE_PID
        EXIT_CODE=$?
        END_TIME=$(date +%s)
        RUNTIME=$((END_TIME - START_TIME))
        rm -f "$PID_FILE"
        if [ ! -f "$SUP_PID_FILE" ]; then
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] [SUPERVISOR] Clean shutdown requested. Exiting supervisor." >> "$LOG_FILE"
            break
        fi

        # Track rapid crashes to prevent thrashing flash disk / CPU
        if [ "$RUNTIME" -lt 15 ]; then
            CRASH_COUNT=$((CRASH_COUNT + 1))
        else
            CRASH_COUNT=0
        fi

        # If crashing repeatedly, check and auto-heal binary
        if [ "$CRASH_COUNT" -ge 3 ]; then
            check_and_heal_node
        fi

        if [ "$CRASH_COUNT" -gt 5 ]; then
            BACKOFF=60
        elif [ "$CRASH_COUNT" -gt 2 ]; then
            BACKOFF=15
        else
            BACKOFF=3
        fi

        echo "[$(date '+%Y-%m-%d %H:%M:%S')] [SUPERVISOR WARN] Node process terminated (exit: $EXIT_CODE, runtime: ${RUNTIME}s, crashes: $CRASH_COUNT). Respawning in ${BACKOFF}s..." >> "$LOG_FILE"
        sleep $BACKOFF
    done
    rm -f "$SUP_PID_FILE"
}

start() {
    echo -n "Starting $DESC... "
    if [ -f "$SUP_PID_FILE" ] && kill -0 $(cat "$SUP_PID_FILE") 2>/dev/null; then
        echo "already running (Supervisor PID: $(cat $SUP_PID_FILE))."
        return 0
    fi

    # Rotate log if it exceeds 5 MB to protect RAM disk space
    rotate_log

    # Verify and heal node before launching supervisor
    check_and_heal_node

    # Clean up any lingering legacy/competing PID files and orphaned node processes
    rm -f /opt/var/run/*msm-getter*.pid
    if netstat -tlpn 2>/dev/null | grep -E ':3033|:3034' >/dev/null 2>&1; then
        echo -n "(cleaning up orphaned node instances holding ports 3033/3034)... "
        killall -9 node 2>/dev/null
        sleep 1
    fi

    # Ensure overcommit memory is enabled for V8 engine
    echo 1 > /proc/sys/vm/overcommit_memory
    # Disable USB flash swap to prevent catastrophic kernel D-state stalls
    swapoff -a 2>/dev/null
    mkdir -p /opt/var/run

    export PATH=/opt/bin:/opt/sbin:$PATH
    export MALLOC_ARENA_MAX=1
    export MALLOC_TRIM_THRESHOLD_=131072
    export MALLOC_MMAP_THRESHOLD_=131072
    cd $APP_DIR

    # Initialize supervisor PID file
    echo $$ > "$SUP_PID_FILE"
    supervisor_loop &
    SUP_PID=$!
    echo $SUP_PID > "$SUP_PID_FILE"

    # Give Node a brief moment to start and write PID
    sleep 1
    if [ -f "$PID_FILE" ]; then
        echo "done (Supervisor: $SUP_PID, Node: $(cat $PID_FILE))."
    else
        echo "done (Supervisor: $SUP_PID)."
    fi
}

stop() {
    echo -n "Stopping $DESC... "
    # 1. Stop supervisor loop first so it will not respawn Node
    if [ -f "$SUP_PID_FILE" ]; then
        SUP_PID=$(cat "$SUP_PID_FILE")
        rm -f "$SUP_PID_FILE"
        kill $SUP_PID 2>/dev/null
    fi
    # 2. Gracefully signal Node process
    if [ -f "$PID_FILE" ]; then
        NODE_PID=$(cat "$PID_FILE")
        kill -TERM $NODE_PID 2>/dev/null
        # Wait up to 5 seconds for node to finish and exit
        for i in 1 2 3 4 5; do
            if kill -0 $NODE_PID 2>/dev/null; then
                sleep 1
            else
                break
            fi
        done
        # Force kill if still lingering
        kill -9 $NODE_PID 2>/dev/null
        rm -f "$PID_FILE"
    fi
    # 3. Fallback cleanup for orphaned node processes
    killall node 2>/dev/null
    echo "done."
}

status() {
    if [ -f "$SUP_PID_FILE" ] && kill -0 $(cat "$SUP_PID_FILE") 2>/dev/null; then
        SUP_PID=$(cat "$SUP_PID_FILE")
        if [ -f "$PID_FILE" ] && kill -0 $(cat "$PID_FILE") 2>/dev/null; then
            NODE_PID=$(cat "$PID_FILE")
            # Verify endpoint health and confirm no looping crashes
            if curl -k -s -m 2 http://127.0.0.1:3034/api/system/stats 2>/dev/null | grep -q '"status":"ok"'; then
                echo "$DESC is running and healthy (Supervisor PID: $SUP_PID, Node PID: $NODE_PID, status: ok)."
                return 0
            else
                echo "$DESC is running (Supervisor PID: $SUP_PID, Node PID: $NODE_PID), but health check probe failed."
                return 1
            fi
        else
            echo "$DESC supervisor is running (PID: $SUP_PID), waiting for node process."
            return 1
        fi
    elif pidof node >/dev/null 2>&1; then
        echo "$DESC unmanaged node process is running (PID: $(pidof node))."
        return 0
    else
        echo "$DESC is stopped."
        return 1
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        sleep 2
        start
        ;;
    status|check)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
